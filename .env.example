# RPCA80 - ระบบเรียกสายตรวจ Configuration

# Flask
FLASK_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production

# Database
DATABASE_URL=sqlite:///rpca80.db

# Session
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# App Settings
TIMEZONE=Asia/Bangkok
LOG_LEVEL=INFO

# SocketIO
SOCKETIO_MESSAGE_QUEUE=redis://localhost:6379
SOCKETIO_CORS_ALLOWED_ORIGINS=*

# Security
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_INCIDENT_CREATE=5/minute

# Demo Accounts (เปลี่ยนในการใช้งานจริง)
DEMO_RADIO_ADMIN_USERNAME=RPCA80
DEMO_RADIO_ADMIN_PASSWORD=RPCA6480
DEMO_CITIZEN_USERNAME=test1234
DEMO_CITIZEN_PASSWORD=12345678
